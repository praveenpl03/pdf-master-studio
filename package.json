{
  "name": "PDF-Master-Studio",
  "version": "1.0.0",
  "description": "A desktop PDF management studio built with Angular and Electron",
  "author": "Praveen <praveenpl03>",
  "license": "MIT",
  "desktopName": "com.pdfmasterstudio.app",
  "main": "electron/main.js",
  "private": true,
  "packageManager": "npm@11.11.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win --x64",
    "desktop:package32": "npm run build && electron-builder --win --ia32",
    "desktop:mac": "npm run build && electron-builder --mac",
    "desktop:linux": "npm run build && electron-builder --linux",
    "desktop:all": "npm run build && electron-builder -mwl"
  },
  "repository": "https://github.com/praveenpl03/pdf-master-studio",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@hyzyla/pdfium": "^2.1.13",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "fabric": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "pdfium-wasm": "^0.0.2",
    "pdfjs-dist": "^6.1.200",
    "qpdf-wasm": "^0.1.0",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/tesseract.js": "^0.0.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "patch-package": "^8.0.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.pdfmasterstudio.app",
    "productName": "PDF Master Studio",
    "directories": {
      "output": "C:\\temp\\theconvertor-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon/win.ico"
    },
    "mac": {
      "target": "default",
      "category": "public.app-category.utilities",
      "icon": "public/favicon/mac.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/favicon/linux.png"
    }
  }
}